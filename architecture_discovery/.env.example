# Use the same GPT-5.6 Sol endpoint for all three controllers.
DISCOVERY_API_KEY=
DISCOVERY_API_BASE=https://api.openai.com/v1
DISCOVERY_MODEL=gpt-5.6-sol

# Engineering defaults only. A scientific run binds these to the frozen
# manifest and refuses shell overrides that disagree.
# Temperature and top-p are intentionally omitted for GPT-5.6 reasoning requests.
DISCOVERY_REASONING_EFFORT=high
DISCOVERY_MAX_COMPLETION_TOKENS=16384
DISCOVERY_REQUEST_TIMEOUT_SECONDS=300
DISCOVERY_REQUEST_RETRIES=2
DISCOVERY_RETRY_DELAY_SECONDS=3

# Strict local candidate training. Scientific runs never fall back to CPU.
# Keep these MPS defaults for the frozen MPS condition. Inside an inspected
# Slurm A40 allocation, pass --profile/--device explicitly. CUDA_VISIBLE_DEVICES
# is scheduler-owned and is never hard-coded here.
DISCOVERY_TRAIN_DEVICE=mps
DISCOVERY_ALLOW_CPU_TRAINING=0
PYTORCH_ENABLE_MPS_FALLBACK=0
DISCOVERY_TRAINING_PROFILE=full_train_v1

# Required by deterministic CUDA profiles. This setting does not authorize
# login-node training, arbitrary candidate execution, or CPU fallback.
CUBLAS_WORKSPACE_CONFIG=:4096:8

# Controller-visible Layer A evaluation. Scientific values must match the
# frozen PI decision ledger; setting an environment variable is not approval.
DISCOVERY_LAYER_A_PROFILE=scientific_layer_a_v1
DISCOVERY_LAYER_A_CASES=
DISCOVERY_SCIENTIFIC_DECISION_RECORD=

# Use the same GPT-5.6 Sol endpoint for all four controller harnesses.
DISCOVERY_API_KEY=
DISCOVERY_API_BASE=https://api.openai.com/v1
DISCOVERY_MODEL=gpt-5.6-sol

# Engineering defaults only. A scientific run binds these to the frozen
# manifest and refuses shell overrides that disagree.
# Temperature and top-p are intentionally omitted for GPT-5.6 reasoning requests.
DISCOVERY_REASONING_EFFORT=high
DISCOVERY_MAX_COMPLETION_TOKENS=16384
DISCOVERY_REQUEST_TIMEOUT_SECONDS=180
DISCOVERY_REQUEST_RETRIES=0
DISCOVERY_RETRY_DELAY_SECONDS=0

# Modal injects provider values through a named Secret. This local example is
# never copied into the Modal image.

# Canonical remote candidate training. Scientific runs never fall back to CPU.
DISCOVERY_TRAIN_DEVICE=cuda
DISCOVERY_ALLOW_CPU_TRAINING=0
PYTORCH_ENABLE_MPS_FALLBACK=0
CUBLAS_WORKSPACE_CONFIG=:4096:8
DISCOVERY_TRAINING_PROFILE=full_train_cuda_v2

# Controller-visible Layer A evaluation. Scientific values must match the
# frozen PI decision ledger; setting an environment variable is not approval.
DISCOVERY_LAYER_A_PROFILE=scientific_layer_a_v1
DISCOVERY_LAYER_A_CASES=
DISCOVERY_SCIENTIFIC_DECISION_RECORD=

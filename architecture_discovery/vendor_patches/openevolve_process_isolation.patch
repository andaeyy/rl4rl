+    def test_controller_initargs_contain_only_api_key_environment_reference(self):
+        """Process-pool pickle payloads never contain provider key bytes."""
+
+        literal_key = "fake-provider-key-never-pickle"
+        model = LLMModelConfig(name="test-model", api_key=literal_key)
+        self.config.llm.api_key = literal_key
+        self.config.llm.models = [model]
+        self.config.llm.evaluator_models = [model]
+        captured = {}
+
+        class FakeExecutor:
+            def __init__(self, **kwargs):
+                captured.update(kwargs)
+
+        controller = ProcessParallelController(
+            self.config, self.eval_file, self.database
+        )
+        with patch.dict(os.environ, {"DISCOVERY_API_KEY": literal_key}), patch.object(
+            process_parallel_module,
+            "ProcessPoolExecutor",
+            FakeExecutor,
+        ):
+            controller.start()
+
+        pickled = pickle.dumps(captured["initargs"])
+        self.assertNotIn(literal_key.encode(), pickled)
+        self.assertIn(b"${DISCOVERY_API_KEY}", pickled)
+        self.assertEqual(len(captured["initargs"]), 2)
+        self.assertNotIn("OPENAI_API_KEY", repr(captured["initargs"]))
+
+    def test_worker_initializer_resolves_reference_before_client_construction(self):
+        """The spawned worker gives the inherited key, not a placeholder, to OpenAI."""
+
+        literal_key = "inherited-fake-provider-key"
+        model = LLMModelConfig(name="test-model", api_key=literal_key)
+        self.config.llm.api_key = literal_key
+        self.config.llm.models = [model]
+        self.config.llm.evaluator_models = [model]
+        controller = ProcessParallelController(
+            self.config, self.eval_file, self.database
+        )
+        client_calls = []
+
+        class FakeOpenAI:
+            def __init__(self, **kwargs):
+                client_calls.append(kwargs)
+
+        from openevolve.llm import openai as openai_module
+        from openevolve.llm.ensemble import LLMEnsemble
+
+        with patch.dict(
+            os.environ, {"DISCOVERY_API_KEY": literal_key}
+        ), patch.object(openai_module.openai, "OpenAI", FakeOpenAI):
+            serialized = controller._serialize_config(self.config)
+            process_parallel_module._worker_init(serialized, self.eval_file)
+            ensemble = LLMEnsemble(
+                process_parallel_module._worker_config.llm.models
+            )
+
+        self.assertEqual(ensemble.models[0].api_key, literal_key)
+        self.assertEqual(client_calls[0]["api_key"], literal_key)
+        self.assertNotEqual(
+            client_calls[0]["api_key"], "${DISCOVERY_API_KEY}"
+        )
+
+    def test_worker_rejects_raw_or_unapproved_api_key_references(self):
+        with patch.dict(
+            os.environ, {"DISCOVERY_API_KEY": "inherited-fake-provider-key"}
+        ):
+            for value in ("literal-key", "${OPENAI_API_KEY}"):
+                with self.subTest(value=value), self.assertRaisesRegex(
+                    ValueError, "approved DISCOVERY_API_KEY reference"
+                ):
+                    process_parallel_module._resolve_worker_api_key_reference(value)
+
+    def test_worker_rejects_missing_inherited_api_key(self):
